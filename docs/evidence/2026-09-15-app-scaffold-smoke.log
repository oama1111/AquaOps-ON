import app.schemas as s
print('schemas exported:', len(s.__all__))
import modules.m1_ingest, modules.m2_detect, modules.m3_schedule
import modules.m4_rules, modules.m5_dashboard, modules.m6_eval
print('modules M1-M6: import OK')
from app.main import app
print('app title:', app.title, '| version:', app.version)

from fastapi.testclient import TestClient
c = TestClient(app)
r = c.get('/health')
print('GET /health ->', r.status_code, r.json())
spec = c.get('/openapi.json').json()
print('openapi version:', spec['info']['version'])
print('paths:', sorted(spec['paths']))

